{
  "app-id": "com.specboard.app",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "23.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "specboard",
  "finish-args": [
    "--share=ipc",
    "--socket=x11",
    "--device=dri",
    "--share=network",
    "--filesystem=home",
    "--talk-name=org.freedesktop.Notifications"
  ],
  "modules": [
    {
      "name": "specboard",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 specboard /app/bin/specboard",
        "install -Dm644 specboard.png /app/share/icons/hicolor/256x256/apps/com.specboard.app.png",
        "install -Dm644 com.specboard.app.desktop /app/share/applications/com.specboard.app.desktop",
        "install -Dm644 com.specboard.app.metainfo.xml /app/share/metainfo/com.specboard.app.metainfo.xml"
      ],
      "sources": [
        {
          "type": "file",
          "path": "specboard",
          "dest-filename": "specboard"
        },
        {
          "type": "file",
          "path": "specboard.png",
          "dest-filename": "specboard.png"
        },
        {
          "type": "file",
          "path": "com.specboard.app.desktop",
          "dest-filename": "com.specboard.app.desktop"
        },
        {
          "type": "file",
          "path": "com.specboard.app.metainfo.xml",
          "dest-filename": "com.specboard.app.metainfo.xml"
        }
      ]
    }
  ]
}
